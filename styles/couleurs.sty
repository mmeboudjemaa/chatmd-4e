\ProvidesPackage{couleurs}

\RequirePackage{xcolor}

% Palette modernisée : bleu vif / orange chaud / gris ardoise / rouge corail
% La logique sémantique est inchangée :
%   Savoir    -> définitions, propriétés, théorèmes
%   Action    -> méthodes, à retenir
%   Neutre    -> exemples, remarques, corrigés, brevet
%   Attention -> erreurs fréquentes

\definecolor{SavoirC}{HTML}{2D6CB5}
\definecolor{SavoirBg}{HTML}{EFF5FB}

\definecolor{ActionC}{HTML}{D97C2B}
\definecolor{ActionBg}{HTML}{FCF4EB}

\definecolor{NeutreC}{HTML}{5C6B7A}
\definecolor{NeutreBg}{HTML}{F5F7F9}

\definecolor{AttentionC}{HTML}{C94F4F}
\definecolor{AttentionBg}{HTML}{FCF1F1}

% Couleur des titres de sections (ardoise foncée, presque noir)
\definecolor{TitreC}{HTML}{22303E}

% Associations (inchangées)

\colorlet{DefC}{SavoirC}
\colorlet{DefBg}{SavoirBg}

\colorlet{PropC}{SavoirC}
\colorlet{PropBg}{SavoirBg}

\colorlet{TheoC}{SavoirC}
\colorlet{TheoBg}{SavoirBg}

\colorlet{MethC}{ActionC}
\colorlet{MethBg}{ActionBg}

\colorlet{RetC}{ActionC}
\colorlet{RetBg}{ActionBg}

\colorlet{ErrC}{AttentionC}
\colorlet{ErrBg}{AttentionBg}

\colorlet{ExC}{NeutreC}
\colorlet{ExBg}{NeutreBg}

\colorlet{RemC}{NeutreC}
\colorlet{RemBg}{NeutreBg}

\colorlet{CorrC}{NeutreC}
\colorlet{CorrBg}{NeutreBg}

\colorlet{BrevC}{NeutreC}
\colorlet{BrevBg}{NeutreBg}
