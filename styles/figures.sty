%==================================================
% Fonction courbe simple
%==================================================

\newcommand{\courbeSimple}{
\begin{tikzpicture}[scale=0.75]
  \draw[grille] (-4,-3) grid (4,3);

  \draw[axe] (-4.2,0)--(4.4,0) node[right] {$x$};
  \draw[axe] (0,-3.2)--(0,3.4) node[above] {$y$};

  \draw[line width=1pt, smooth, domain=-2.2:2.2] plot(\x,{0.5*\x*\x-1});

  \node[below left] at (0,0) {$O$};
\end{tikzpicture}
}