\ProvidesPackage{boites}

\RequirePackage[most]{tcolorbox}
\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{fontawesome5}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% STYLE GÉNÉRAL
%% Design plat : coins arrondis uniformes, pas de cadre par
%% défaut, fonds très clairs, accent coloré à gauche.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tcbset{
  mathsbox/.style={
    enhanced,
    breakable,
    arc=2.5mm,
    boxsep=2mm,
    left=4mm,
    right=4mm,
    top=2.5mm,
    bottom=2.5mm,
    before skip=12pt,
    after skip=12pt,
    before upper={\clubpenalty=10000 \widowpenalty=10000 \displaywidowpenalty=10000}
  }
}

%% Titre intérieur des boîtes plates : icône + libellé sans serif
\NewDocumentCommand{\titreboite}{m m m}{%
  {\sffamily\bfseries\small\color{#1}#2\hspace{0.6em}#3}\par
  \nobreak\vspace{0.45em}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% DÉFINITION
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\definition}{+m}{
\begin{tcolorbox}[
mathsbox,
frame hidden,
colback=DefBg,
borderline west={1.2mm}{0pt}{DefC}
]

\titreboite{DefC}{\faBook}{DÉFINITION}

#1

\end{tcolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% PROPRIÉTÉ
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\propriete}{+m}{
\begin{tcolorbox}[
mathsbox,
colback=PropBg,
colframe=PropC!40,
boxrule=0.6pt,
borderline west={1.2mm}{0pt}{PropC}
]

\titreboite{PropC}{\faStar}{PROPRIÉTÉ}

#1

\end{tcolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% THÉORÈME (titre en onglet, boîte la plus « solennelle »)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\theoreme}{+m}{
\begin{tcolorbox}[
mathsbox,
colback=TheoBg,
colframe=TheoC,
boxrule=0.8pt,
top=5mm,
attach boxed title to top left={xshift=4mm,yshift=-2.5mm},
boxed title style={
colback=TheoC,
boxrule=0pt,
arc=1.2mm,
left=2.5mm, right=2.5mm, top=1.2mm, bottom=1.2mm
},
coltitle=white,
fonttitle=\sffamily\bfseries\small,
title={\faGem\hspace{0.5em}THÉORÈME}
]

#1

\end{tcolorbox}
}

