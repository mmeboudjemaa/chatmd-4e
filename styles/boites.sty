%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% EXERCICE CORRIGÉ (bandeau de titre clair)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcounter{correction}

\NewDocumentCommand{\correction}{+m}{
\refstepcounter{correction}

\begin{tcolorbox}[
mathsbox,
colback=white,
colframe=CorrC!40,
boxrule=0.6pt,
colbacktitle=CorrBg,
coltitle=CorrC,
fonttitle=\sffamily\bfseries\small,
title={\faCheckCircle\hspace{0.5em}EXERCICE CORRIGÉ \thecorrection}
]

#1

\end{tcolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% SOUS-PARTIES D'UN EXERCICE CORRIGÉ
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\enonce}{
\par\medskip
{\sffamily\bfseries\small\color{NeutreC}ÉNONCÉ}
\par\smallskip
}

\newcommand{\redaction}{
\par\medskip
{\sffamily\bfseries\small\color{NeutreC}RÉDACTION ATTENDUE}
\par\smallskip
}

\newcommand{\solution}{
\par\medskip
{\sffamily\bfseries\small\color{NeutreC}SOLUTION}
\par\smallskip
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% BREVET
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcounter{brevet}

\NewDocumentCommand{\brevet}{+m}{
\refstepcounter{brevet}

\begin{tcolorbox}[
mathsbox,
colback=white,
colframe=BrevC!40,
boxrule=0.6pt,
colbacktitle=BrevBg,
coltitle=BrevC,
fonttitle=\sffamily\bfseries\small,
title={\faGraduationCap\hspace{0.5em}EXERCICE TYPE BREVET \thebrevet}
]

#1

\end{tcolorbox}
}
